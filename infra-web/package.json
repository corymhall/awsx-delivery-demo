{
  "name": "awsx-delivery-demo-infra-web",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "format": "cd .. && oxfmt -c infra-web/.oxfmtrc.json --write infra-web/index.ts shared/web.ts",
    "format:check": "cd .. && oxfmt -c infra-web/.oxfmtrc.json --check infra-web/index.ts shared/web.ts",
    "lint": "cd .. && oxlint -c infra-web/.oxlintrc.json --deny-warnings infra-web/index.ts shared/web.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@pulumi/awsx-next": "file:sdks/pulumi-awsx-next",
    "@pulumi/pulumi": "^3.275.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "allowScripts": {
    "file:sdks/pulumi-awsx-next": true
  }
}
